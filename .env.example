# Also used for KakaoTalk sharing (Kakao.Share) — enable the "카카오톡 공유" product
# for this app's JavaScript key in the Kakao Developers console.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=
GEMINI_API_KEY=
# Kakao Local API (search.kakao.com-backed place search) — a different key type than
# NEXT_PUBLIC_KAKAO_MAP_APP_KEY, from the same app's "플랫폼 키" page in the Kakao
# Developers console. Used server-side only by one-off data-enrichment scripts.
KAKAO_REST_API_KEY=
# scripts/sync-seoul-places.mjs only — 한국관광공사 TourAPI 서비스키 (data.go.kr 마이페이지
# > 오픈API 활용신청 현황에서 재발급/확인). URL-encoded 상태로 저장해도 됨(스크립트가
# decodeURIComponent 처리). 데이터 정합성 이슈로 당분간 재동기화 계획 없음 — 그래도 키 자체는
# 이 파일에 적어둬야 다음에 .env.local 옮길 때 또 빠뜨리지 않음.
TOURAPI_SERVICE_KEY=
# 기본값 있음(코드 참고) — 바꿀 때만 설정.
# TOURAPI_ENDPOINT=
# HERITAGE_API_ENDPOINT=
